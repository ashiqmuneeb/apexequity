# Secrets: never commit (keep .env.example tracked)
.env
.env.local
*.env
*.env.local
!.env.example
!**/.env.example

# Python
/venv/
/.venv/
/backend/venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/

# Node / frontend build
/node_modules/
/frontend/node_modules/
/dist/
/frontend/dist/

# Generated data (recreated by scripts)
/backend/storage/
/storage/
/backend/data/
/data/
/backend/articles/*_10K.txt

# Databases & Archives
*.db
*.sqlite
*.sqlite3
*.zip

# Local-only documents with unverified claims
ApexEquity_Project_and_Interview_Guide.pdf

# Evaluation cache (never commit model response cache)
/backend/eval/cache/
eval/cache/
!/backend/eval/golden.jsonl
!/backend/eval/results/latest.json
!/docs/EVALUATION.md

# Logs
*.log
logs/
/logs/
/backend/logs/
/frontend/logs/

# OS / Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.sw?
